# Copy this file to /opt/openclaw-license/openclaw-license.env on the server.
# Keep the production file out of git and restrict it with: chmod 600.
#
# Use the same token in:
# - launcher publish page Relay Token
# - CLI --relay-token
# - APKClaw publish relay settings
OPENCLAW_PUBLISH_RELAY_TOKEN=replace-with-long-random-token

# Shared only by the license server and the model-account bridge.
# Set OPENCLAW_LICENSE_ENTITLEMENT_SERVICE_TOKEN on the bridge to the exact
# same random value. Do not reuse OPENCLAW_PUBLISH_RELAY_TOKEN.
LICENSE_ACCOUNT_REDEEM_SERVICE_TOKEN=replace-with-a-long-random-account-entitlement-token

# Optional in-app Z-Pay / 易支付 checkout. Keep disabled until the current
# provider domain and mapi.php contract have been verified against its official
# documentation. PID/key remain server-side and this file must stay chmod 600.
LICENSE_ZPAY_ENABLED=0
LICENSE_ZPAY_BASE_URL=https://verified-provider.example
LICENSE_ZPAY_PID=replace-with-merchant-id
LICENSE_ZPAY_KEY=replace-with-merchant-secret
LICENSE_ZPAY_CREATE_PATH=/mapi.php
LICENSE_ZPAY_NOTIFY_URL=https://license.heang.top/api/payments/zpay/notify
LICENSE_ZPAY_RETURN_URL=https://license.heang.top/api/payments/zpay/return
LICENSE_ZPAY_ORDER_TTL_SECONDS=600
