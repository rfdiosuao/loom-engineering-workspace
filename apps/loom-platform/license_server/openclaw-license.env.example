# Copy this file to /opt/openclaw-license/openclaw-license.env on the server.
# Keep the production file out of git and restrict it with: chmod 600.
#
# Use the same token in:
# - launcher publish page Relay Token
# - CLI --relay-token
# - APKClaw publish relay settings
OPENCLAW_PUBLISH_RELAY_TOKEN=replace-with-long-random-token

# Shared only by the license server and the model-account bridge.
# Set OPENCLAW_LICENSE_ENTITLEMENT_SERVICE_TOKEN on the bridge to the exact
# same random value. Do not reuse OPENCLAW_PUBLISH_RELAY_TOKEN.
LICENSE_ACCOUNT_REDEEM_SERVICE_TOKEN=replace-with-a-long-random-account-entitlement-token
