# Account-bound Matrix entitlement settings for openclaw_newapi_bridge.py.
# Keep the production file out of git and restrict it to the service account.

# Must exactly match LICENSE_ACCOUNT_REDEEM_SERVICE_TOKEN on the license server.
# Generate a dedicated random value; do not reuse model API or publish relay tokens.
OPENCLAW_LICENSE_ENTITLEMENT_SERVICE_TOKEN=replace-with-the-shared-account-entitlement-token
OPENCLAW_LICENSE_ENTITLEMENT_SERVICE_BASE=https://license.heang.top

# Keep one-time bind tickets, entitlement versions, revocations, and audit events on
# persistent storage. Do not place this database in /tmp or an ephemeral container layer.
OPENCLAW_BIND_DB=/mnt/data/openclaw/openclaw-bridge-state.db

# Encrypt one-time bind-ticket payloads at rest. Use at least 32 random bytes and
# preserve the value across restarts until all outstanding short-lived tickets expire.
OPENCLAW_BIND_TICKET_SECRET=replace-with-a-dedicated-random-secret

# Sign opaque one-time checkout links independently from login bind tickets.
# Preserve this value across restarts so an unexpired QR code remains usable.
OPENCLAW_SUBSCRIPTION_CHECKOUT_SECRET=replace-with-a-second-dedicated-random-secret
OPENCLAW_SUBSCRIPTION_CHECKOUT_TTL_SEC=1800

# Native New API EPay may only receive browser form posts on these exact HTTPS hosts.
# Production currently uses Z-Pay on zpayz.cn and only enables Alipay upstream.
OPENCLAW_SUBSCRIPTION_PAYMENT_FORM_HOSTS=zpayz.cn

# Separate GPLv3 Linux runtime companion, served byte-for-byte after a SHA-256 check.
OPENCLAW_LINUX_COMPANION_APK_PATH=/opt/openclaw-newapi-bridge/downloads/LumiLinuxRuntime.apk
OPENCLAW_LINUX_COMPANION_APK_SHA256=3E301AEBFE8F1E6E9F5736D0FAE9577967281180DAE938B1CB03D65E04208DD6

# Account and phone-seat leases must use the existing LOOM license signing key.
# Its public key and key ID are pinned in every desktop client. The bridge refuses
# to start if either value does not match, preventing production from minting
# leases that installed clients cannot verify.
OPENCLAW_ENTITLEMENT_PRIVATE_KEY_FILE=/opt/openclaw-license/private_key.b64
OPENCLAW_ENTITLEMENT_KEY_ID=openclaw-ed25519-v1

# Online leases are short lived. A previously issued signed lease may remain valid
# offline for at most 72 hours; outages must not mint a fresh paid lease.
OPENCLAW_ENTITLEMENT_LEASE_TTL_SEC=3600
OPENCLAW_ENTITLEMENT_OFFLINE_GRACE_SEC=259200
