<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hybrid fixture"
            android:textColor="#101820"
            android:textSize="22sp" />

        <Button
            android:id="@+id/native_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Native target" />

        <Button
            android:id="@+id/delayed_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delayed target" />

        <Button
            android:id="@+id/duplicate_target_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Twin label" />

        <Button
            android:id="@+id/duplicate_target_two"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Twin label" />

        <Button
            android:id="@+id/reset_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset" />

        <com.apk.claw.android.debug.HybridVisualTargetView
            android:id="@+id/visual_target"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Visual target" />

        <TextView
            android:id="@+id/result_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="fixture_ready"
            android:textColor="#101820"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
